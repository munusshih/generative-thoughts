{
  "name": "generative-thoughts",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first p5.js studio for turning intact writing into generative Instagram carousels.",
  "scripts": {
    "dev": "vite dist --host 0.0.0.0",
    "build": "vite build dist --outDir ../site-dist --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0 --outDir site-dist",
    "check": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@ibm/plex-mono": "^2.5.0",
    "@vercel/blob": "^2.8.0",
    "jszip": "3.10.2",
    "mediabunny": "^1.58.0",
    "p5": "2.3.3"
  },
  "devDependencies": {
    "vite": "8.3.0"
  }
}
